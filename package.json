{
  "name": "inkslate",
  "version": "0.1.0",
  "description": "墨与石板（Inkslate）— 一款支持 HTML 显示的 Markdown 桌面笔记应用",
  "main": "dist/main/index.js",
  "author": "heimin",
  "license": "MIT",
  "scripts": {
    "dev:vite": "vite",
    "dev:build-main": "tsc -p tsconfig.main.json --watch",
    "dev:build-preload": "tsc -p tsconfig.preload.json --watch",
    "dev:electron": "electron .",
    "dev": "concurrently -k -n vite,tsc-main,tsc-preload,electron -c blue,yellow,magenta,green \"npm:dev:vite\" \"npm:dev:build-main\" \"npm:dev:build-preload\" \"wait-on dist/main/index.js dist/preload/index.js && npx electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build:preload": "tsc -p tsconfig.preload.json",
    "build:renderer": "vite build",
    "build": "npm run build:main && npm run build:preload && npm run build:renderer",
    "pack": "npm run build && electron-builder",
    "pack:win": "npm run build && electron-builder --win",
    "pack:mac": "npm run build && electron-builder --mac",
    "pack:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-html": "^6.4.11",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.12.3",
    "@codemirror/state": "^6.6.0",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.1",
    "@lezer/highlight": "^1.2.3",
    "@traptitech/markdown-it-katex": "^3.6.0",
    "@types/diff": "^7.0.2",
    "ali-oss": "^6.20.0",
    "better-sqlite3": "^11.3.0",
    "diff": "^9.0.0",
    "docx-preview": "^0.3.7",
    "dompurify": "^3.1.7",
    "exceljs": "^4.4.0",
    "highlight.js": "^11.10.0",
    "isomorphic-git": "^1.38.6",
    "js-beautify": "^1.15.1",
    "katex": "^0.16.11",
    "lucide-react": "^0.460.0",
    "markdown-it": "^14.1.0",
    "mermaid": "^11.15.0",
    "pdfjs-dist": "^6.1.200",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sql-formatter": "^15.8.1",
    "x-data-spreadsheet": "^1.1.9",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@monaco-editor/react": "^4.6.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/dompurify": "^3.0.5",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "com.inkslate.app",
    "productName": "Inkslate",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "resources/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
